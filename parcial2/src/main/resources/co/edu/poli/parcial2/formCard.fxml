<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>

<TabPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="250.0" prefWidth="600.0" tabClosingPolicy="UNAVAILABLE" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="co.edu.poli.parcial2.controlador.ControlFormCard">
  <tabs>
    <Tab text="Consultar">
      <content>
        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="215.0" prefWidth="200.0">
               <children>
                  <Button fx:id="bttConsulta" layoutX="314.0" layoutY="38.0" mnemonicParsing="false" onAction="#pressConsulta" prefHeight="25.0" prefWidth="144.0" text="Consulta" />
                  <TextField fx:id="txtTarjeta1" layoutX="127.0" layoutY="38.0" promptText="Numero tarjeta" />
                  <TextArea fx:id="txtAreaResultado" layoutX="69.0" layoutY="78.0" prefHeight="76.0" prefWidth="462.0" editable="false" />
                  <!-- HU-01: visualización del estado de la tarjeta consultada -->
                  <Label fx:id="lblEstado" layoutX="69.0" layoutY="170.0" prefWidth="165.0" text="Estado: -" style="-fx-font-weight: bold;" />
                  <!-- HU-01: asignación de un nuevo estado -->
                  <ComboBox fx:id="cmbNuevoEstado" layoutX="240.0" layoutY="166.0" prefHeight="25.0" prefWidth="145.0" promptText="Nuevo estado" disable="true" />
                  <Button fx:id="bttCambiarEstado" layoutX="395.0" layoutY="166.0" mnemonicParsing="false" onAction="#pressCambiarEstado" prefHeight="25.0" prefWidth="136.0" text="Cambiar estado" disable="true" />
               </children></AnchorPane>
      </content>
    </Tab>
    <Tab text="Crear">
      <content>
        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="215.0" prefWidth="557.0">
               <children>
                  <TextField fx:id="txtTarjeta2" layoutX="46.0" layoutY="50.0" promptText="Numero tarjeta" />
                  <DatePicker fx:id="datepk1" layoutX="225.0" layoutY="50.0" prefWidth="150.0" promptText="Fecha Expedición" />
                  <ComboBox fx:id="cmbTitular" layoutX="408.0" layoutY="50.0" prefHeight="25.0" prefWidth="150.0" promptText="Titular" />
                  <!-- HU-01: estado obligatorio al crear la tarjeta -->
                  <ComboBox fx:id="cmbEstado" layoutX="46.0" layoutY="121.0" prefHeight="25.0" prefWidth="149.0" promptText="Estado *" />
                  <RadioButton fx:id="radio1" layoutX="225.0" layoutY="125.0" mnemonicParsing="false" selected="true" text="Débito">
                     <toggleGroup>
                        <ToggleGroup fx:id="tipo" />
                     </toggleGroup>
                  </RadioButton>
                  <RadioButton fx:id="radio2" layoutX="310.0" layoutY="125.0" mnemonicParsing="false" text="Crédito" toggleGroup="$tipo" />
                  <Button fx:id="bttCreacion" layoutX="408.0" layoutY="121.0" mnemonicParsing="false" onAction="#pressCreacion" prefHeight="25.0" prefWidth="150.0" text="Creación" />
                  <Label layoutX="46.0" layoutY="160.0" text="* Campo obligatorio" style="-fx-text-fill: #777777; -fx-font-size: 11px;" />
               </children></AnchorPane>
      </content>
    </Tab>
  </tabs>
</TabPane>
