@startuml diagrama-clases
' Diagrama de clases — parcial2 v2.0 (HU-01: estado de la tarjeta)
' Elementos nuevos o modificados por la HU-01 resaltados en amarillo.
skinparam classAttributeIconSize 0
skinparam packageStyle folder
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 60
skinparam class {
  BackgroundColor white
  BorderColor black
  ArrowColor black
  BackgroundColor<<HU-01>> #FFF4C2
}
hide empty members
hide circle
title Diagrama de clases — HU-01 Estado de la tarjeta

package "co.edu.poli.parcial2.modelo" {

  abstract class Tarjeta <<HU-01>> {
    - numero : String
    - fechaExp : String
    - estado : Estado
    - titular : Titular
    + Tarjeta(numero : String, fechaExp : String, estado : Estado, titular : Titular)
    + getEstado() : Estado
    + setEstado(estado : Estado) : void
    + puedeUsarse() : boolean
    + bloquear() : String
    + activar() : String
    + cancelar() : String
    + {abstract} getTipo() : String
    - validarNoCancelada() : void
  }

  enum "Tarjeta::Estado" as Estado <<enumeration>> <<HU-01>> {
    ACTIVA
    BLOQUEADA
    CANCELADA
    --
    - etiqueta : String
    + getEtiqueta() : String
    + permiteUso() : boolean
    + {static} desdeTexto(valor : String) : Estado
  }

  class Titular {
    - id : String
    - nombre : String
  }

  class Debito {
    - saldo : double
    + getTipo() : String
  }

  class Credito {
    - limite : double
    + getTipo() : String
  }

  ' Con linetype ortho PlantUML dibuja las multiplicidades invertidas;
  ' se escriben al revés para que la imagen muestre Tarjeta * → 1 Titular.
  Titular "*" <-left-* "1" Tarjeta
  ' Estado es un enum anidado (miembro) de Tarjeta
  Estado -right-+ Tarjeta
  Debito -up-|> Tarjeta : Extends
  Credito -up-|> Tarjeta : Extends
}

package "co.edu.poli.parcial2.servicios" {

  interface "CRUD<T>" as CRUD {
    + create(t : T) : String
    + readone(id : K) : <K> T
    + readall() : List<T>
  }

  class ConexionBD {
    - {static} instancia : ConexionBD
    - conexion : Connection
    - ConexionBD()
    + {static} getInstancia() : ConexionBD
    + getConexion() : Connection
  }

  class DAOTarjeta <<HU-01>> {
    + create(t : Tarjeta) : String
    + readone(num : K) : Tarjeta
    + readall() : List<Tarjeta>
    + validarParaGuardar(t : Tarjeta) : String
    + actualizarEstado(numero : String, nuevoEstado : Estado) : String
    - leerTitular(rs : ResultSet) : Titular
  }

  class DAOTitular <<HU-01>> {
    + create(t : Titular) : String
    + readone(id : K) : Titular
    + readall() : List<Titular>
    + validarParaGuardar(t : Titular) : String
  }

  ConexionBD "1" *--> "1" ConexionBD
  DAOTarjeta .up.|> CRUD
  DAOTitular .up.|> CRUD
}

package "co.edu.poli.parcial2.controlador" {
  class ControlFormCard <<HU-01>> {
    - tablaTarjetas : TableView<Tarjeta>
    - tablaTitulares : TableView<Titular>
    - cmbEstado : ComboBox<Estado>
    - cmbNuevoEstado : ComboBox<Estado>
    - cmbTitular : ComboBox<Titular>
    - tarjetas : ObservableList<Tarjeta>
    - titulares : ObservableList<Titular>
    - cargarDatos(numero : String) : void
    - aplicarFiltro() : void
    - mostrarDetalle(t : Tarjeta) : void
    - pressCambiarEstado(event : ActionEvent) : void
    - pressCreacion(event : ActionEvent) : void
    - pressNuevoTitular(event : ActionEvent) : void
    - pressGuardarTitular(event : ActionEvent) : void
  }
}

ControlFormCard --> DAOTarjeta
ControlFormCard --> DAOTitular
DAOTarjeta ..> Tarjeta : <<use>>
DAOTarjeta ..> Estado : <<use>>
@enduml
